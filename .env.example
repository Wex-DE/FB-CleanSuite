# Meta App Credentials (Optional if importing Page Access Token directly in Dashboard)
# Create your app at https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=

# Official Meta Graph API Version (defaults to v26.0 or latest supported)
META_API_VERSION=v26.0

# Redirect URI configured in Facebook Login settings
META_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Master key for AES-256 local token encryption (Optional: if empty, auto-generated in data/secrets.key)
TOKEN_ENCRYPTION_KEY=
